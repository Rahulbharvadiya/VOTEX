# VOTEX Environment Configuration Example
# Copy this file to .env and provide real credentials in development.

# Application Environment (dev | staging | prod)
APP_ENV=dev
PORT=8000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Security & Sessions
JWT_SECRET_KEY=change-this-to-a-very-secure-random-32-byte-hex-key-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=sqlite+aiosqlite:///./votex.db

# Storage & Workspaces
WORKSPACES_DIR=./workspaces
MAX_FILE_SIZE_MB=50
MAX_TOTAL_UPLOAD_MB=100
MAX_UPLOAD_FILES=5

# Agent & Budget Hard Caps
MAX_STEPS_CAP=30
MAX_COST_INR_CAP=20.0
MAX_SECONDS_CAP=300
MAX_CONCURRENT_TASKS=4

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_TASKS_PER_HOUR=10

# Pilot Controls
PILOT_INVITE_ONLY=false
NEW_TASKS_ENABLED=true
ADMIN_KEY=change-this-admin-key-in-prod
